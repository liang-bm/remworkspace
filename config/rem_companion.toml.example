# Public first-run defaults. Contains no user's chat, memory, API key or voice clips.
[project]
root = "."
speaker = "companion"
language = "ja"

[dataset]
source_dirs = ["voice-source"]
output_dir = "data/voice-dataset"
sample_rate = 32000
channels = 1
lead_padding_ms = 120
tail_padding_ms = 180
minimum_duration_seconds = 0.70
maximum_duration_seconds = 12.0
validation_ratio = 0.10
random_seed = 233333

[training]
version = "v2Pro"
experiment_name = "companion_ja_v2pro"
gpu_index = "0"
use_fp16 = true
sovits_batch_size = 1
sovits_epochs = 8
sovits_save_every_epoch = 2
sovits_gradient_checkpointing = true
gpt_batch_size = 1
gpt_epochs = 15
gpt_save_every_epoch = 5
gpt_use_dpo = false

[services]
tts_host = "127.0.0.1"
tts_port = 19880
llm_host = "127.0.0.1"
llm_port = 8080
llm_context = 4096
llm_gpu_layers = 20

[llm]
model = "rem-local"
endpoint_path = "/v1/chat/completions"
auto_start = false
temperature = 0.75
top_p = 0.9
max_tokens = 420
history_messages = 12
memory_items = 8
timeout_seconds = 120
system_prompt = "You are a helpful desktop companion. Be accurate, respect user control, and never claim unobserved actions."

[companion]
default_speech_mode = "ja"
autoplay = false
follow_pet = true
window_width = 580
window_height = 380
follow_interval_ms = 80

[tts_inference]
reference_audio = "voice-source/reference.wav"
reference_text = ""
reference_language = "ja"
default_text_language = "zh"
text_split_method = "cut2"
seed = 42
top_k = 15
top_p = 1.0
temperature = 1.0
speed_factor = 1.0
repetition_penalty = 1.35

[tts_profiles.ja]
text_language = "ja"
reference_audio = "voice-source/reference.wav"
reference_text = ""
reference_language = "ja"
text_split_method = "cut2"

[tts_profiles.zh]
text_language = "zh"
reference_audio = "voice-source/reference.wav"
reference_text = ""
reference_language = "ja"
text_split_method = "cut2"

[downloads]
gpt_sovits_git = "https://github.com/RVC-Boss/GPT-SoVITS.git"
gpt_sovits_revision = "main"
gpt_pretrained_repo = "lj1995/GPT-SoVITS"
qwen_url = "https://huggingface.co/bartowski/Qwen_Qwen3.5-4B-GGUF/resolve/main/Qwen_Qwen3.5-4B-Q4_K_M.gguf?download=true"
qwen_filename = "Qwen_Qwen3.5-4B-Q4_K_M.gguf"
llama_repo = "ggml-org/llama.cpp"
ffmpeg_repo = "BtbN/FFmpeg-Builds"
g2pw_url = "https://huggingface.co/XXXXRT/GPT-SoVITS-Pretrained/resolve/main/G2PWModel.zip?download=true"
nltk_url = "https://huggingface.co/XXXXRT/GPT-SoVITS-Pretrained/resolve/main/nltk_data.zip?download=true"
open_jtalk_url = "https://huggingface.co/XXXXRT/GPT-SoVITS-Pretrained/resolve/main/open_jtalk_dic_utf_8-1.11.tar.gz?download=true"
fast_langdetect_url = "https://dl.fbaipublicfiles.com/fasttext/supervised-models/lid.176.bin"
